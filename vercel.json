{
  "version": 2,
  "cleanUrls": true,
  "outputDirectory": ".",
  "functions": {
    "api/auth.js": {
      "maxDuration": 10
    },
    "api/payments/[...path].js": {
      "maxDuration": 15
    },
    "api/webhooks/razorpay.js": {
      "maxDuration": 10
    },
    "api/logs.js": {
      "maxDuration": 5
    },
    "api/redeem.js": {
      "maxDuration": 10
    },
    "api/waitlist.js": {
      "maxDuration": 5
    },
    "api/membership/[...path].js": {
      "maxDuration": 15
    },
    "api/creator-commerce/[...path].js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/razorpay-config",
      "destination": "/api/payments/config"
    },
    {
      "source": "/api/auth/:action*",
      "destination": "/api/auth"
    },
    {
      "source": "/api/subscriptions/check-access",
      "destination": "/api/membership/legacy-check-access"
    },
    {
      "source": "/passport",
      "destination": "/passport/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/ecosystem",
      "destination": "/ecosystem/index.html"
    },
    {
      "source": "/store",
      "destination": "/store/index.html"
    },
    {
      "source": "/sell",
      "destination": "/sell/index.html"
    },
    {
      "source": "/membership",
      "destination": "/membership/index.html"
    },
    {
      "source": "/redeem",
      "destination": "/passport/redeem"
    },
    {
      "source": "/@:handle",
      "destination": "/store/creator.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=86400, stale-while-revalidate"
        }
      ]
    }
  ]
}
